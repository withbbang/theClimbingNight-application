# NAS의 <배포 폴더>/deploy/.env 로 복사해 값을 채운다. 키 설명은 deploy/README.md 5장.
# IMAGE_TAG 는 배포 워크플로가 커밋 SHA로 써 넣는다. 비우면 latest.
IMAGE_TAG=

# MySQL (compose 안의 전용 인스턴스)
MYSQL_ROOT_PASSWORD=
DB_USERNAME=theclimbingnight
DB_PASSWORD=

# API
JWT_SECRET=
KAKAO_APP_ID=
GOOGLE_CLIENT_IDS=
APPLE_AUDIENCES=com.theclimbingnight.app
APPLE_CLIENT_ID=com.theclimbingnight.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 내용 전체를 한 줄로. 줄바꿈은 \n 으로 적는다.
APPLE_PRIVATE_KEY=
EXPO_ACCESS_TOKEN=

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=
# 터널의 Public Hostname과 같은 값 (예: api.example.com). 배포 확인에 쓴다.
PUBLIC_HOST=

# DB 백업을 R2에도 올릴 때 (backup.sh). 비우면 NAS에만 남긴다.
R2_ACCOUNT_ID=
R2_BACKUP_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
