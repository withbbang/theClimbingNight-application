# NAS의 <배포 폴더>/deploy/.env 로 복사해 값을 채운다. 키 설명은 deploy/README.md 5장.
# IMAGE_TAG 는 배포 워크플로가 커밋 SHA로 써 넣는다. 비우면 latest.
IMAGE_TAG=

# MySQL (compose 안의 전용 인스턴스)
MYSQL_ROOT_PASSWORD=
DB_USERNAME=theclimbingnight
DB_PASSWORD=

# API
JWT_SECRET=
KAKAO_APP_ID=
GOOGLE_CLIENT_IDS=
APPLE_AUDIENCES=com.theclimbingnight.app
APPLE_CLIENT_ID=com.theclimbingnight.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 내용 전체를 한 줄로. 줄바꿈은 \n 으로 적는다.
APPLE_PRIVATE_KEY=
EXPO_ACCESS_TOKEN=

# 사진 피드 (api·worker 공통). 앞의 R2 키 다섯 개와 MEDIA_PUBLIC_BASE_URL 중 하나라도 비면 사진 올리기가 꺼진다(MEDIA_UNAVAILABLE).
# R2_ACCOUNT_ID는 아래 백업용 키를 같이 쓴다.
R2_MEDIA_ACCESS_KEY_ID=
R2_MEDIA_SECRET_ACCESS_KEY=
R2_MEDIA_INCOMING_BUCKET=
R2_MEDIA_PUBLIC_BUCKET=
# 공개 버킷에 연결한 커스텀 도메인 (예: https://media.example.com)
MEDIA_PUBLIC_BASE_URL=
# 워커만. NAS의 원본 사진 폴더(compose가 컨테이너의 /media/originals 로 마운트). compose 전용 키
MEDIA_ORIGINALS_HOST_DIR=/volume1/docker/theclimbingnight/media/originals
# 워커만. 숨긴 사진의 CDN 캐시 비우기. 해당 Zone의 Cache Purge 권한만 준다. 비면 비우지 않는다.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CACHE_PURGE_TOKEN=

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=
# 터널의 Public Hostname과 같은 값 (예: api.example.com). 배포 확인에 쓴다.
PUBLIC_HOST=

# DB 백업을 R2에도 올릴 때 (backup.sh). 비우면 NAS에만 남긴다.
R2_ACCOUNT_ID=
R2_BACKUP_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
