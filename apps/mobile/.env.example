# API 주소. iOS 시뮬레이터: http://localhost:8080, Android 에뮬레이터: http://10.0.2.2:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
# 웹뷰 페이지 주소. 비우면 API 주소를 쓴다. 로컬에서는 http://localhost:3000 (Android 에뮬레이터: http://10.0.2.2:3000)
EXPO_PUBLIC_WEB_URL=

# 소셜 로그인. 값이 없으면 그 로그인 버튼을 숨긴다.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
EXPO_PUBLIC_NAVER_CLIENT_ID=
# 네이버 SDK가 요구해 앱 번들에 들어간다. 서버 인증에는 쓰지 않는다.
EXPO_PUBLIC_NAVER_CLIENT_SECRET=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# 푸시. EAS 프로젝트 ID와 google-services.json 경로 (빌드할 때만 쓴다)
EAS_PROJECT_ID=
GOOGLE_SERVICES_JSON=
