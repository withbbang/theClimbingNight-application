# prod 프로파일에서 필요한 값. 키 목록만 관리한다.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://localhost:3306/theclimbingnight
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
KAKAO_APP_ID=
GOOGLE_CLIENT_IDS=
APPLE_AUDIENCES=
# Apple 로그인 탈퇴 시 토큰 폐기용. 키(.p8)는 Apple Developer → Keys에서 Sign in with Apple로 발급한다.
# APPLE_PRIVATE_KEY는 .p8 내용 전체. 한 줄로 넣을 땐 줄바꿈을 \n으로 적는다. 셋 중 하나라도 비면 폐기하지 않는다.
APPLE_CLIENT_ID=com.theclimbingnight.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
EXPO_ACCESS_TOKEN=
# 사진 피드 R2 저장소. 앞의 다섯 개 중 하나라도 비면 사진 올리기가 꺼진다(MEDIA_UNAVAILABLE).
# R2_ACCOUNT_ID는 기존 키를 재사용한다. 비공개 버킷에는 uploads/(수명 주기 1일)와 quarantine/을 둔다.
R2_ACCOUNT_ID=
R2_MEDIA_ACCESS_KEY_ID=
R2_MEDIA_SECRET_ACCESS_KEY=
R2_MEDIA_INCOMING_BUCKET=
R2_MEDIA_PUBLIC_BUCKET=
MEDIA_PUBLIC_BASE_URL=
# 워커가 쓰는 원본 사진 경로(컨테이너 안). 기본 /media/originals
MEDIA_ORIGINALS_DIR=/media/originals
# 워커만: 숨긴 사진의 Cloudflare CDN 캐시 비우기. 토큰은 해당 zone의 Cache Purge 권한만. 비면 캐시를 비우지 않는다.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CACHE_PURGE_TOKEN=
